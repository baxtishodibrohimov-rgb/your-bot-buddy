# Frontend build-time vars (Vite) — copy this file to .env and fill in your
# own Supabase project. These are safe to expose to the browser (anon/publishable
# key only) and are read directly by src/integrations/supabase/client.ts.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLISHABLE-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-ID"

# Same values without the VITE_ prefix, used by server-side code
# (src/integrations/supabase/client.server.ts, auth-middleware.ts) under SSR.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-ANON-PUBLISHABLE-KEY"

# ---------------------------------------------------------------------------
# Everything below this line is NOT read from this file. It must be set as
# Supabase Edge Function secrets (`supabase secrets set KEY=value`), never as
# a frontend env var and never committed anywhere. Listed here purely so it's
# documented in one place what the Treatment Plan Manager needs at runtime.
# ---------------------------------------------------------------------------

# Required for Edge Functions to use the service role (bypasses RLS) — set
# automatically by `supabase functions deploy`, no action needed locally.
# SUPABASE_SERVICE_ROLE_KEY=

# Telegram (shared with the existing patient bot's connector gateway):
# LOVABLE_API_KEY=
# TELEGRAM_API_KEY=

# Base URL of the deployed admin app, used to build the "PLAN'NI OCHISH"
# Telegram button link. Omit and notifications just skip the button.
# APP_BASE_URL=https://admin.your-clinic.example

# Cliniccards — omit all of these to run entirely on the built-in mock
# adapter (default, zero-config). Set the first two once real credentials +
# API docs are available; the *_PATH vars only need overriding if
# Cliniccards' REST paths differ from the guessed defaults in
# supabase/functions/_shared/cliniccards/http-provider.ts.
# CLINICCARDS_MODE=mock            # force mock even if credentials are set
# CLINICCARDS_API_URL=
# CLINICCARDS_API_KEY=
# CLINICCARDS_API_KEY_HEADER=Authorization
# CLINICCARDS_PATIENTS_PATH=/patients
# CLINICCARDS_APPOINTMENTS_PATH=/appointments
# CLINICCARDS_APPOINTMENT_BY_ID_PATH=/appointments/{appointmentId}
# CLINICCARDS_PATIENT_DOCUMENTS_PATH=/patients/{patientId}/documents
# CLINICCARDS_PATIENT_IMAGES_PATH=/patients/{patientId}/images

# Shared secret Cliniccards must send back on webhook calls (header
# x-cliniccards-signature or x-webhook-secret). Omit only for local testing.
# CLINICCARDS_WEBHOOK_SECRET=
